# Copy to .env.local for local dev. On Vercel add these under Settings → Environment Variables.

# Final site URL (used for canonical links, sitemap, Open Graph). Leave empty on Vercel test links.
NEXT_PUBLIC_SITE_URL=

# Keep 0 on test links (site returns noindex). Set 1 ONLY on the final domain.
NEXT_PUBLIC_ALLOW_INDEXING=0

# "PENDING VERIFICATION" flags on unconfirmed facts. Keep 1 until the client signs off.
NEXT_PUBLIC_SHOW_PENDING=1

# Show Careers page + nav link (1 = show).
NEXT_PUBLIC_SHOW_CAREERS=1

# Site background: image (default) | 3d (Three.js wireframes) | off
NEXT_PUBLIC_BG_MODE=image

# Optional: URL of the plant film (mp4). Empty = placeholder frame.
NEXT_PUBLIC_PLANT_FILM_URL=

# Optional: where RDSO PDFs live. Default = client's current site. Use /rdso/ after copying PDFs to public/rdso/.
NEXT_PUBLIC_RDSO_BASE=

# RFQ email (resend.com). Without these the form still works but only logs the RFQ on the server.
RESEND_API_KEY=
RFQ_TO_EMAIL=info@parasmaniengineering.com
# Sender must be on a domain verified in Resend, e.g. "PEPL Website <rfq@parasmaniengineering.com>"
RFQ_FROM_EMAIL=
